{
  "template_version": 1,
  "name": "json-v1",
  "type": "json",
  "description": "Legacy schema-1 report, byte-identical to the pre-milestone JSON output.",
  "requires_extensions": [],
  "schema_version": 1,
  "output": { "indent": 2, "ensure_ascii": true, "sort_keys": false },
  "body": {
    "schema_version": { "$var": "schema_version" },
    "profile": { "$var": "profile" },
    "documents": {
      "$for": "inventory",
      "as": "doc",
      "each": { "path": { "$var": "doc.path" }, "bytes": { "$var": "doc.bytes" } }
    },
    "findings": {
      "$for": "findings",
      "as": "f",
      "each": {
        "rule": { "$var": "f.rule" },
        "path": { "$var": "f.document_path" },
        "message": { "$var": "f.message" },
        "severity": { "$var": "f.severity" },
        "line": { "$var": "f.line" }
      }
    },
    "enabled_rules": { "$var": "enabled_rules" },
    "pending": { "$var": "pending" },
    "notice": { "$var": "notice" },
    "advisory": { "$omit_if": { "var": "advisory", "falsy": true }, "value": { "$var": "advisory" } }
  }
}
